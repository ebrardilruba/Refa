# =========================
# ANDROID
# =========================
/android/.gradle/
**/local.properties
**/key.properties

# Keystore dosyalarını asla commit etme
**/*.jks
**/*.keystore

# Android Studio build varyant klasörleri (ekstra güvence)
/android/app/debug/
/android/app/profile/
/android/app/release/

# (Firebase dosyalarını gizli tutmak istiyorsan yorumdan çıkar)
# android/app/google-services.json

# =========================
# iOS
# =========================
# CocoaPods
ios/Pods/
# iOS build ara çıktıları
ios/.symlinks/
ios/Flutter/.last_build_id
ios/Flutter/ephemeral/
# Xcode kullanıcıya özel dosyalar
**/xcuserdata/
# DerivedData (global, proje dışına da koyabilir)
# DerivedData/

# (Firebase dosyalarını gizli tutmak istiyorsan yorumdan çıkar)
# ios/Runner/GoogleService-Info.plist

# Flutter, bu podspec'in izlenmesine izin verir (default'ta sorun yok)
# !ios/Flutter/Flutter.podspec

